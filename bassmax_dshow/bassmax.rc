// bassmax.rc  —  属性页 / 托盘设置对话框 + 字符串
#pragma code_page(65001)
#include <windows.h>
#include "resource.h"
#include "version.h"

IDI_APP ICON "bassmax.ico"
IDI_APP_OFF ICON "bassmax_off.ico"

// 供 CreateActCtx 主动激活 (rundll32 宿主没有 comctl32 v6 清单, 靠这份拿视觉样式)
1 24 "bassmax.manifest"

// ---- 属性页 (必须是 WS_CHILD, 由 CBasePropertyPage 放进播放器的属性对话框) ----
IDD_BASSMAX DIALOGEX 0, 0, 240, 172
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_CAPTION
CAPTION "BassMax"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    CONTROL         "总开关", IDC_CHK_ON, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 6, 23, 50, 12
    CONTROL         "标准乐", IDC_PRE0, "BUTTON", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_GROUP | WS_TABSTOP, 58, 6, 48, 15
    CONTROL         "古典乐", IDC_PRE1, "BUTTON", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP, 112, 6, 48, 15
    CONTROL         "俱乐部", IDC_PRE2, "BUTTON", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP, 58, 24, 48, 15
    CONTROL         "流行乐", IDC_PRE3, "BUTTON", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP, 112, 24, 48, 15
    CONTROL         "爵士乐", IDC_PRE4, "BUTTON", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP, 58, 42, 48, 15
    CONTROL         "摇滚乐", IDC_PRE5, "BUTTON", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP, 112, 42, 48, 15

    LTEXT           "低音", IDC_LBL_BASS, 8, 68, 30, 10
    CONTROL         "", IDC_SLD_BASS, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 44, 63, 140, 18
    RTEXT           "0.0 dB", IDC_TXT_BASS, 188, 68, 44, 10

    LTEXT           "高音", IDC_LBL_TREBLE, 8, 88, 30, 10
    CONTROL         "", IDC_SLD_TREBLE, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 44, 83, 140, 18
    RTEXT           "0.0 dB", IDC_TXT_TREBLE, 188, 88, 44, 10

    LTEXT           "驱动", IDC_LBL_DRIVE, 8, 108, 30, 10
    CONTROL         "", IDC_SLD_DRIVE, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 44, 103, 140, 18
    RTEXT           "0 %", IDC_TXT_DRIVE, 188, 108, 44, 10

    LTEXT           "驱动: 把安静段拉向满电平, 超过的压回; 0 = 关闭效果", IDC_HINT, 8, 126, 226, 10
    LTEXT           "低音/高音: 100Hz 低架 / 9kHz 高架增益 (dB), 用来补厚度与空气感", IDC_HINT2, 8, 138, 226, 10
    LTEXT           "总开关: 未勾选时整条链路直接旁路, 不做任何处理", IDC_HINT3, 8, 150, 226, 10
    LTEXT           "只建议 1-2 声道; 多声道请先用 LAV 混缩为立体声", IDC_HINT4, 8, 162, 226, 10
END

// ---- 托盘双击后的独立设置窗口 ----
IDD_BASSMAX_POPUP DIALOGEX 0, 0, 240, 172
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "BassMax 音频增强"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    CONTROL         "总开关", IDC_CHK_ON, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 6, 23, 50, 12
    CONTROL         "标准乐", IDC_PRE0, "BUTTON", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_GROUP | WS_TABSTOP, 58, 6, 48, 15
    CONTROL         "古典乐", IDC_PRE1, "BUTTON", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP, 112, 6, 48, 15
    CONTROL         "俱乐部", IDC_PRE2, "BUTTON", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP, 58, 24, 48, 15
    CONTROL         "流行乐", IDC_PRE3, "BUTTON", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP, 112, 24, 48, 15
    CONTROL         "爵士乐", IDC_PRE4, "BUTTON", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP, 58, 42, 48, 15
    CONTROL         "摇滚乐", IDC_PRE5, "BUTTON", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP, 112, 42, 48, 15

    LTEXT           "低音", IDC_LBL_BASS, 8, 68, 30, 10
    CONTROL         "", IDC_SLD_BASS, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 44, 63, 140, 18
    RTEXT           "0.0 dB", IDC_TXT_BASS, 188, 68, 44, 10

    LTEXT           "高音", IDC_LBL_TREBLE, 8, 88, 30, 10
    CONTROL         "", IDC_SLD_TREBLE, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 44, 83, 140, 18
    RTEXT           "0.0 dB", IDC_TXT_TREBLE, 188, 88, 44, 10

    LTEXT           "驱动", IDC_LBL_DRIVE, 8, 108, 30, 10
    CONTROL         "", IDC_SLD_DRIVE, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 44, 103, 140, 18
    RTEXT           "0 %", IDC_TXT_DRIVE, 188, 108, 44, 10

    LTEXT           "驱动: 把安静段拉向满电平, 超过的压回; 0 = 关闭效果", IDC_HINT, 8, 126, 226, 10
    LTEXT           "低音/高音: 100Hz 低架 / 9kHz 高架增益 (dB), 用来补厚度与空气感", IDC_HINT2, 8, 138, 226, 10
    LTEXT           "总开关: 未勾选时整条链路直接旁路, 不做任何处理", IDC_HINT3, 8, 150, 226, 10
    LTEXT           "只建议 1-2 声道; 多声道请先用 LAV 混缩为立体声", IDC_HINT4, 8, 162, 226, 10
END

STRINGTABLE
BEGIN
    IDS_TITLE       "BassMax 音频增强"
    IDS_APP_TITLE   "BassMax"
END

// ---- 版本信息 (资源管理器 -> 属性 -> 详细信息 可见) ----
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    BASSMAX_VER_MAJOR,BASSMAX_VER_MINOR,BASSMAX_VER_PATCH,BASSMAX_VER_BUILD
 PRODUCTVERSION BASSMAX_VER_MAJOR,BASSMAX_VER_MINOR,BASSMAX_VER_PATCH,BASSMAX_VER_BUILD
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L
 FILETYPE       0x2L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName",      "BassMax"
            VALUE "FileDescription",  "BassMax Audio Enhancer (DirectShow audio filter)"
            VALUE "FileVersion",      BASSMAX_VER_STR4
            VALUE "InternalName",     "bassmax_dshow"
            VALUE "OriginalFilename", "bassmax_dshow.ax"
            VALUE "ProductName",      "BassMax Audio Enhancer"
            VALUE "ProductVersion",   BASSMAX_VER_STR4
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END

// bassmax.rc  —  属性页 / 托盘设置对话框 + 字符串
#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

// ---- 属性页 (必须是 WS_CHILD, 由 CBasePropertyPage 放进播放器的属性对话框) ----
IDD_BASSMAX DIALOGEX 0, 0, 240, 132
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_CAPTION
CAPTION "BassMax"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    LTEXT           "音效风格", IDC_LBL_STYLE, 8, 24, 44, 10
    CONTROL         "标准乐", IDC_PRE0, "BUTTON", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_GROUP | WS_TABSTOP, 58, 6, 48, 15
    CONTROL         "古典乐", IDC_PRE1, "BUTTON", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP, 112, 6, 48, 15
    CONTROL         "俱乐部", IDC_PRE2, "BUTTON", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP, 58, 24, 48, 15
    CONTROL         "流行乐", IDC_PRE3, "BUTTON", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP, 112, 24, 48, 15
    CONTROL         "爵士乐", IDC_PRE4, "BUTTON", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP, 58, 42, 48, 15
    CONTROL         "摇滚乐", IDC_PRE5, "BUTTON", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP, 112, 42, 48, 15

    LTEXT           "低音", IDC_LBL_BASS, 8, 68, 30, 10
    CONTROL         "", IDC_SLD_BASS, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 44, 63, 140, 18
    RTEXT           "0.0 dB", IDC_TXT_BASS, 188, 68, 44, 10

    LTEXT           "驱动", IDC_LBL_DRIVE, 8, 88, 30, 10
    CONTROL         "", IDC_SLD_DRIVE, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 44, 83, 140, 18
    RTEXT           "0 %", IDC_TXT_DRIVE, 188, 88, 44, 10

    LTEXT           "驱动: 把安静段拉向满电平, 超过的压回; 0 = 关闭效果", IDC_HINT, 8, 106, 226, 10
    LTEXT           "低音: 100Hz 低架增益 (dB)", IDC_HINT2, 8, 118, 226, 10
END

// ---- 托盘双击后的独立设置窗口 ----
IDD_BASSMAX_POPUP DIALOGEX 0, 0, 240, 132
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "BassMax 音频增强"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    LTEXT           "音效风格", IDC_LBL_STYLE, 8, 24, 44, 10
    CONTROL         "标准乐", IDC_PRE0, "BUTTON", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_GROUP | WS_TABSTOP, 58, 6, 48, 15
    CONTROL         "古典乐", IDC_PRE1, "BUTTON", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP, 112, 6, 48, 15
    CONTROL         "俱乐部", IDC_PRE2, "BUTTON", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP, 58, 24, 48, 15
    CONTROL         "流行乐", IDC_PRE3, "BUTTON", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP, 112, 24, 48, 15
    CONTROL         "爵士乐", IDC_PRE4, "BUTTON", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP, 58, 42, 48, 15
    CONTROL         "摇滚乐", IDC_PRE5, "BUTTON", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP, 112, 42, 48, 15

    LTEXT           "低音", IDC_LBL_BASS, 8, 68, 30, 10
    CONTROL         "", IDC_SLD_BASS, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 44, 63, 140, 18
    RTEXT           "0.0 dB", IDC_TXT_BASS, 188, 68, 44, 10

    LTEXT           "驱动", IDC_LBL_DRIVE, 8, 88, 30, 10
    CONTROL         "", IDC_SLD_DRIVE, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 44, 83, 140, 18
    RTEXT           "0 %", IDC_TXT_DRIVE, 188, 88, 44, 10

    LTEXT           "驱动: 把安静段拉向满电平, 超过的压回; 0 = 关闭效果", IDC_HINT, 8, 106, 226, 10
    LTEXT           "低音: 100Hz 低架增益 (dB)", IDC_HINT2, 8, 118, 226, 10
END

STRINGTABLE
BEGIN
    IDS_TITLE       "BassMax 音频增强"
    IDS_APP_TITLE   "BassMax"
END
